[Unit]
Description=Personal Assistant portfolio market-data refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.openclaw/workspace
Environment=OPENCLAW_WORKSPACE=%h/.openclaw/workspace
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/personal-assistant/secrets.env
ExecStart=%h/.openclaw/workspace/scripts/assistant.sh portfolio quotes refresh
SuccessExitStatus=1
TimeoutStartSec=5min
Nice=10
UMask=0077

[Install]
WantedBy=default.target
