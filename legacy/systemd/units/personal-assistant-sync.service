[Unit]
Description=Personal Assistant incremental knowledge sync
After=network-online.target mail-agent.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.openclaw/workspace
Environment=OPENCLAW_WORKSPACE=%h/.openclaw/workspace
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/mail-agent.env
EnvironmentFile=-%h/.config/personal-assistant/secrets.env
ExecStart=%h/.openclaw/workspace/scripts/assistant.sh index all
TimeoutStartSec=30min
Nice=10
UMask=0077

[Install]
WantedBy=default.target
