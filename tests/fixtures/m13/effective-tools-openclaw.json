{
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace"
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token"
    }
  },
  "tools": {
    "profile": "coding",
    "alsoAllow": [
      "personal-assistant-tools"
    ],
    "fs": {
      "workspaceOnly": true
    }
  },
  "plugins": {
    "load": {
      "paths": [
        "/opt/openclaw-plugins/personal-assistant-tools"
      ]
    },
    "entries": {
      "personal-assistant-tools": {
        "enabled": true,
        "hooks": {
          "allowConversationAccess": true,
          "allowPromptInjection": true
        }
      }
    }
  }
}
