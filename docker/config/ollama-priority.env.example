# Replace with the actual Ollama server. With host networking, 127.0.0.1 is the Docker host.
OLLAMA_PRIORITY_UPSTREAM=http://127.0.0.1:11434
OLLAMA_PRIORITY_LISTEN_HOST=127.0.0.1
OLLAMA_PRIORITY_LISTEN_PORT=11435
OLLAMA_PRIORITY_QUEUE_TIMEOUT=900
OLLAMA_PRIORITY_UPSTREAM_TIMEOUT=600
OLLAMA_PRIORITY_MAX_PENDING=128
OLLAMA_PRIORITY_MAX_CONCURRENCY=1
OLLAMA_PRIORITY_BACKGROUND_CONCURRENCY=1
OLLAMA_PRIORITY_BACKGROUND_BURST_CONCURRENCY=1
OLLAMA_PRIORITY_BACKGROUND_BURST_IDLE_SECONDS=5
