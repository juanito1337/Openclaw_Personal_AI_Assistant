{
  "id": "personal-assistant-tools",
  "name": "Personal Assistant Tools",
  "description": "Native structured tools, deterministic routing and evidence guards for the local Personal Assistant",
  "version": "3.4.0-r29.0.6",
  "contracts": {
    "tools": [
      "personal_assistant_runtime_read",
      "personal_assistant_runtime_write",
      "personal_assistant_mail_read",
      "personal_assistant_mail_write",
      "personal_assistant_nextcloud_read",
      "personal_assistant_nextcloud_write",
      "personal_assistant_contacts_read",
      "personal_assistant_contacts_write",
      "personal_assistant_calendar_read",
      "personal_assistant_calendar_write",
      "personal_assistant_tasks_read",
      "personal_assistant_tasks_write",
      "personal_assistant_orders_read",
      "personal_assistant_orders_write",
      "personal_assistant_invoices_read",
      "personal_assistant_invoices_write",
      "personal_assistant_portfolio_read",
      "personal_assistant_portfolio_write",
      "personal_assistant_security_read"
    ]
  },
  "toolMetadata": {
    "personal_assistant_runtime_read": {
      "replaySafe": true
    },
    "personal_assistant_mail_read": {
      "replaySafe": true
    },
    "personal_assistant_nextcloud_read": {
      "replaySafe": true
    },
    "personal_assistant_contacts_read": {
      "replaySafe": true
    },
    "personal_assistant_calendar_read": {
      "replaySafe": true
    },
    "personal_assistant_tasks_read": {
      "replaySafe": true
    },
    "personal_assistant_orders_read": {
      "replaySafe": true
    },
    "personal_assistant_invoices_read": {
      "replaySafe": true
    },
    "personal_assistant_portfolio_read": {
      "replaySafe": true
    },
    "personal_assistant_security_read": {
      "replaySafe": true
    }
  },
  "activation": {
    "onStartup": true
  },
  "channels": [
    "nextcloud-account-talk"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "setupUiEnabled": {
        "type": "boolean",
        "default": true,
        "description": "Nextcloud-Einrichtungsseite für Administratoren anzeigen. Benötigt den separaten Einrichtungsdienst."
      },
      "accountTalkEnabled": {
        "type": "boolean",
        "default": true,
        "description": "Den nativen Nextcloud-Kontokanal bereitstellen. Aktive Räume und Benutzer werden separat in der Einrichtung bestätigt."
      }
    }
  },
  "uiHints": {
    "setupUiEnabled": {
      "label": "Nextcloud-Einrichtung anzeigen",
      "help": "Nextcloud einrichten in der Seitenleiste öffnen: Serveradresse eingeben, bei Nextcloud anmelden und Ressourcen prüfen. Keine Zugangsdaten hier eingeben."
    },
    "accountTalkEnabled": {
      "label": "Nextcloud-Kontokanal bereitstellen",
      "help": "Der Kanal wartet bis zur ausdrücklich bestätigten Talk-Auswahl. Diese Option erteilt keine Raum- oder Benutzerfreigaben."
    }
  }
}
