# The installer replaces these examples with verified immutable registry
# digests. Tags alone are not accepted by the M7 deployment gate.
OPENCLAW_IMAGE=ghcr.io/juanito1337/openclaw_personal_ai_assistant:r28
OPENCLAW_PROXY_IMAGE=ghcr.io/juanito1337/openclaw_personal_ai_assistant:r28-proxy
OPENCLAW_MAINTENANCE_IMAGE=ghcr.io/juanito1337/openclaw_personal_ai_assistant:r28-maintenance
OPENCLAW_IMAGE_REPOSITORY=ghcr.io/juanito1337/openclaw_personal_ai_assistant
OPENCLAW_CURRENT_RUNTIME=docker
OPENCLAW_EXPECTED_RELEASE=3.4.0-r28
# Exact 40-character commit is mandatory for deploy.sh and is normally supplied
# by the release workflow/deployment operator.
OPENCLAW_EXPECTED_SOURCE_REVISION=
OPENCLAW_SIGNATURE_ISSUER=https://token.actions.githubusercontent.com
OPENCLAW_SIGNATURE_IDENTITY_REGEXP='^https://github.com/juanito1337/Openclaw_Personal_AI_Assistant/.github/workflows/container.yml@refs/(heads/main|heads/test/.+|tags/r.+)$'
OPENCLAW_LEGACY_HOME=
OPENCLAW_BASE_IMAGE=ghcr.io/openclaw/openclaw:2026.7.1-2@sha256:8789721d2e9b24b780a1504b56deb4c6bd5c7dbf96a1dd117e7c45c2ed72c8ac
NODE_BASE_IMAGE=node:24-alpine3.22@sha256:191c9f0080fcbbc6547a85dc0ff7988072214a355aabdc1d2ec55a7dae5eea8a
PYTHON_BASE_IMAGE=python:3.11-alpine3.22@sha256:a4fc589b32e824f3f02ed9d7e7be19518aa47e105b80416336af9f202275a489
HIMALAYA_VERSION=1.2.0
HIMALAYA_ARCHIVE_SHA256=e04e6382e3e664ef34b01afa1a2216113194a2975d2859727647b22d9b36d4e4
HIMALAYA_SHA256=9529d2584add1c4343f32524e6f985e7c98d491f3b854747318020eb1ec1df7f
SOURCE_DATE_EPOCH=0

TZ=Europe/Berlin
OPENCLAW_GATEWAY_PORT=18789
# Keep the only published application port on loopback. A deliberate remote
# reverse proxy binding must be reviewed separately.
OPENCLAW_GATEWAY_BIND_ADDRESS=127.0.0.1
OPENCLAW_ROOT=/srv/openclaw
OPENCLAW_STATE_DIR=/srv/openclaw/state
OPENCLAW_CONFIG_DIR=/srv/openclaw/config
OPENCLAW_SECRETS_DIR=/srv/openclaw/secrets
HIMALAYA_CONFIG_DIR=/srv/openclaw/config/himalaya
OPENCLAW_BACKUP_DIR=/srv/openclaw/backups/releases

MAIL_INTERVAL_SECONDS=1200
MAIL_INITIAL_DELAY_SECONDS=120
MAIL_DRAIN_BATCH_SIZE=20
MAIL_MAX_MESSAGES=500
MAIL_MAX_RUNTIME=2400
MAIL_SHUTDOWN_RESERVE=180
MAIL_MAX_BATCHES=100
SYNC_INTERVAL_SECONDS=900
SYNC_INITIAL_DELAY_SECONDS=300
SUPERVISOR_INTERVAL_SECONDS=300
SUPERVISOR_INITIAL_DELAY_SECONDS=180
PORTFOLIO_INTERVAL_SECONDS=900
PORTFOLIO_INITIAL_DELAY_SECONDS=240
MONITOR_INTERVAL_SECONDS=3600
MONITOR_INITIAL_DELAY_SECONDS=420
SCHEDULER_LEASE_SECONDS=90
SCHEDULER_ARBITRATION_SECONDS=2
SCHEDULER_STARVATION_SECONDS=1800
CLAMAV_SIGNATURE_MAX_AGE_SECONDS=172800
CLAMAV_UPDATE_INTERVAL_SECONDS=14400

# A write-enabled product smoke test happens only after a verified local backup.
OPENCLAW_WRITE_TEST_ENABLED=true
OPENCLAW_WRITE_TEST_LIMIT=3
# Enable only after the persistent direct-mail read permission was explicitly
# configured. The unique smoke query is read-only and expects zero matches.
OPENCLAW_MAIL_SEARCH_SMOKE_ENABLED=false

# Remote IMAP/Nextcloud/CardDAV/CalDAV changes are not inside the local volume.
# This installation uses a restricted Nextcloud account and manual backups for critical data.
# Set the requirement to true and configure both hooks when automatic external rollback is needed.
REQUIRE_EXTERNAL_BACKUP_FOR_WRITE_TEST=false
OPENCLAW_EXTERNAL_BACKUP_HOOK=
OPENCLAW_EXTERNAL_RESTORE_HOOK=

BACKUP_RETENTION_RELEASES=10
