[Unit]
Description=OpenClaw Mail Interface (bounded inbox drain)
After=network-online.target ollama-priority-proxy.service
Wants=network-online.target ollama-priority-proxy.service

[Service]
Type=oneshot
WorkingDirectory=%h/.openclaw/workspace
Environment=OPENCLAW_WORKSPACE=%h/.openclaw/workspace
Environment=PYTHONUNBUFFERED=1
Environment=OPENCLAW_OLLAMA_PRIORITY=background
Environment=OPENCLAW_OLLAMA_SOURCE=mail-interface-timer
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/mail-agent.env
EnvironmentFile=-%h/.config/personal-assistant/secrets.env
ExecStart=%h/.openclaw/workspace/scripts/mail-agent.sh run --drain --batch-size 20 --max-messages 500 --max-runtime 2400 --shutdown-reserve 180 --max-batches 100 --no-digest
TimeoutStartSec=50min
TimeoutStopSec=2min
KillSignal=SIGTERM
Nice=5
UMask=0077

[Install]
WantedBy=default.target
