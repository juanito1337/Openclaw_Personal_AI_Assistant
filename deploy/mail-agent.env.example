# Legacy compatibility file. New installations should use
# ~/.config/personal-assistant/secrets.env with chmod 600.
# Keep the real file outside Git. The Nextcloud setup assistant writes the active
# values; placeholders remain commented so they cannot be mistaken for credentials.

# NEXTCLOUD_URL=https://nextcloud.example.invalid
# NEXTCLOUD_USER=example-user
# NEXTCLOUD_TOKEN=replace-with-app-password

# Enable when Node.js must use a locally installed private CA.
# NODE_USE_SYSTEM_CA=1

# Optional direct CalDAV backend; normally not needed with the verified bridge.
# MAIL_AGENT_CALDAV_URL=https://nextcloud.example.invalid/remote.php/dav/calendars/example-user/personal/
# MAIL_AGENT_CALDAV_USERNAME=example-user
# MAIL_AGENT_CALDAV_PASSWORD=replace-with-app-password
