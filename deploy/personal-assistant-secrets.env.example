# Copy to ~/.config/personal-assistant/secrets.env and chmod 600.
# Use a dedicated non-admin Nextcloud user and a revocable app password.

# NEXTCLOUD_URL=https://nextcloud.example.invalid
# NEXTCLOUD_USER=example-user
# NEXTCLOUD_TOKEN=replace-with-app-password

# Future connector credentials use separate, named variables and are referenced
# from resources.toml. Never store secrets in resources.toml or config.toml.
